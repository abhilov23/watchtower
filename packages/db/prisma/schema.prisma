generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id       String @id @default(uuid())
  email    String @unique
  username String @unique
  password String

  websites Website[]
}


model Website {
  id     String @id @default(uuid())
  name   String
  url    String

  // Monitoring configuration
  method             HttpMethod    @default(GET)
  intervalSeconds    Int           @default(60)
  timeoutMs          Int           @default(10000)
  expectedStatusCode Int           @default(200)
  monitorStatus      MonitorStatus @default(ACTIVE)

  // Owner
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  regions WebsiteRegion[]

  ticks WebsiteTick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([monitorStatus])
}



model Region {
  id      String  @id @default(uuid())
  name    String
  code    String  @unique
  enabled Boolean @default(true)

  websites WebsiteRegion[]

  // Historical checks from this region
  ticks WebsiteTick[]
}


// ========================
// WEBSITE <-> REGION
// ========================

model WebsiteRegion {
  websiteId String
  regionId  String

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  region  Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([websiteId, regionId])
  @@index([regionId])
}


// ========================
// WEBSITE CHECK RESULT
// ========================

model WebsiteTick {
  id String @id @default(uuid())

  responseTimeMs Int
  status         WebsiteStatus
  statusCode     Int?

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([websiteId, createdAt])
  @@index([regionId, createdAt])
  @@index([websiteId, regionId, createdAt])
}


// ========================
// ENUMS
// ========================

enum WebsiteStatus {
  UP
  DOWN
  UNKNOWN
}

enum MonitorStatus {
  ACTIVE
  PAUSED
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}