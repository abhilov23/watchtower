generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Website{
  id                  String       @id @default(uuid())
  url                 String
  timeAdded           DateTime     @default(now())
  ticks             websiteTick[] 
}

model Region {
  id                  String      @id @default(uuid())
  name                String
  ticks             websiteTick[]
}

model websiteTick {
  id                   String     @id @default(uuid())
  response_time_ts     Int
  status               websiteStatus
  region             Region     @relation(fields: [regionId], references: [id])
  website            Website    @relation(fields: [websiteId], references: [id])
  regionId           String
  websiteId          String
} 

enum websiteStatus {
  UP 
  DOWN
  UNKNOWN
}