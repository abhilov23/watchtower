# Watchtower Worker Configuration
# Region identifier (e.g. ap-south-1, us-east-1, eu-central-1)
REGION_CODE=ap-south-1

# Optional specific Region UUID
REGION_ID=

# Upstash or local Redis URL for BullMQ
REDIS_URL="rediss://default:your_token@your_redis_host.upstash.io:6379"

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Worker concurrency
CONCURRENCY=10

# Autonomous polling interval in seconds
POLL_INTERVAL_SECONDS=15
