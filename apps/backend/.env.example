# Watchtower Backend Environment Variables
# Copy this to .env and fill in real values

# Resend API (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# The email address to send from (must be verified in Resend)
# In dev you can use: onboarding@resend.dev (Resend's default test sender)
RESEND_FROM=Watchtower <onboarding@resend.dev>

# Frontend URL — used to build the reset-password link in emails
FRONTEND_URL=http://localhost:3002

# Server port (optional, defaults to 3000)
PORT=3000
